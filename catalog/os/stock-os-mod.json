{
  "schema_version": 1,
  "id": "stock-os-mod",
  "name": "Stock OS MOD (cbepx-me)",
  "tier": "additional",
  "status": "supported_upstream",
  "devices": ["anbernic-rg35xx-h"],
  "release": {
    "channel": "stable",
    "policy": "follow_latest_compatible",
    "known_version": "4.0.4",
    "known_version_date": "2026-10-25",
    "source": "https://github.com/cbepx-me/Anbernic-H700-RG-xx-StockOS-Modification/releases",
    "version_pin_allowed": true,
    "notes": "4.0.4 is an update release, not a standalone full image. Resolve the supported base and ordered update chain."
  },
  "boot": {
    "mode": "native_firmware",
    "adapter": "stock-mod-update-chain",
    "kernel_model": "own_kernel",
    "artifacts": ["compatible Stock OS base image", "MOD base package", "ordered update packages"],
    "requires_dtb": true,
    "requires_known_ram": false,
    "write_capable": false
  },
  "requirements": {
    "board": ["rg35xx-h"],
    "ram": ["ddr3", "ddr4", "unknown"],
    "panel": ["rg35xx-h", "rg35xx-h-rev6"],
    "minimum_free_bytes": 0
  },
  "dependencies": ["stock-os"],
  "warnings": ["The MOD base installation must be detected before applying any update. A delta release is not a full firmware image."]
}
