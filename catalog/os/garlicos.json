{
  "schema_version": 1,
  "id": "garlicos",
  "name": "GarlicOS 2",
  "tier": "additional",
  "status": "supported_upstream",
  "devices": ["anbernic-rg35xx-h"],
  "release": {
    "channel": "stable",
    "policy": "follow_latest_compatible",
    "known_version": "2.0.2",
    "known_version_date": "2026-05-04",
    "source": "https://github.com/GarlicOS/buildroot/releases",
    "version_pin_allowed": true,
    "notes": "Rootfs release must be paired with its matching init template."
  },
  "boot": {
    "mode": "stock_dmenu_handoff",
    "adapter": "anbernic-dmenu-tf2",
    "kernel_model": "host_kernel",
    "artifacts": ["Stock TF1 dmenu.bin", "device-resources/deviceinfo", "TF2 boot/init", "armhf rootfs"],
    "requires_dtb": false,
    "requires_known_ram": false,
    "write_capable": false
  },
  "requirements": {
    "board": ["rg35xx-h"],
    "ram": ["ddr3", "ddr4", "unknown"],
    "panel": ["rg35xx-h", "rg35xx-h-rev6"],
    "minimum_free_bytes": 0
  },
  "dependencies": [],
  "warnings": ["The documented bootloader checks TF2 first and falls back to Stock OS on TF1.", "This init/rootfs hand-off is not a native U-Boot multiboot entry."]
}
